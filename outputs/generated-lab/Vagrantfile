  config.vm.define "reverse-proxy-1" do |reverse_proxy_1|
    reverse_proxy_1.vm.box = "cyberctf/debian_wazuh"
    reverse_proxy_1.vm.communicator = "ssh"
    reverse_proxy_1.ssh.username = "vagrant"
    reverse_proxy_1.ssh.private_key_path = KEY_DEBIAN
