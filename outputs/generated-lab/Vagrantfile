    pfsense_data_1.ssh.keys_only = true
    pfsense_data_1.ssh.shell = "/bin/sh"

    pfsense_data_1.vm.network "private_network", virtualbox__intnet: "core-transit-net", auto_config: false
    pfsense_data_1.vm.network "private_network", virtualbox__intnet: "data-net", auto_config: false

    pfsense_data_1.vm.provider "virtualbox" do |vb|
      vb.name = "pfsense-data-1"
      vb.cpus = 2
      vb.memory = 2048
      vb.gui = false
    end
  end


  config.vm.define "bastion-1" do |bastion_1|
    bastion_1.vm.box = "cyberctf/debian_wazuh"
    bastion_1.vm.communicator = "ssh"
    bastion_1.ssh.username = "vagrant"
