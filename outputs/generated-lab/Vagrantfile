Vagrant.configure("2") do |config|
  config.vm.box_check_update = false
  config.vm.boot_timeout = 2800

  KEY_PFSENSE = File.expand_path("../../keys/ssh/vagrant/vagrant.key.rsa", __dir__)
  KEY_DEBIAN  = File.expand_path("~/.vagrant.d/insecure_private_key")

  config.ssh.insert_key = false
  config.ssh.keys_only  = true

  config.vm.synced_folder ".", "/vagrant", disabled: true


  config.vm.define "pfsense-edge-1" do |pfsense_edge_1|
    pfsense_edge_1.vm.box = "cyberctf/firewall"
    pfsense_edge_1.vm.communicator = "ssh"
    pfsense_edge_1.ssh.username = "vagrant"
    pfsense_edge_1.ssh.private_key_path = KEY_PFSENSE
    pfsense_edge_1.ssh.insert_key = false
    pfsense_edge_1.ssh.keys_only = true
    pfsense_edge_1.ssh.shell = "/bin/sh"

    pfsense_edge_1.vm.network "private_network", virtualbox__intnet: "management-net", auto_config: false
    pfsense_edge_1.vm.network "private_network", virtualbox__intnet: "dmz-net", auto_config: false
    pfsense_edge_1.vm.network "private_network", virtualbox__intnet: "core-transit-net", auto_config: false

    pfsense_edge_1.vm.provider "virtualbox" do |vb|
      vb.name = "pfsense-edge-1"
      vb.cpus = 2
      vb.memory = 2048
      vb.gui = false
    end
  end


  config.vm.define "pfsense-soc-1" do |pfsense_soc_1|
    pfsense_soc_1.vm.box = "cyberctf/firewall"
    pfsense_soc_1.vm.communicator = "ssh"
    pfsense_soc_1.ssh.username = "vagrant"
    pfsense_soc_1.ssh.private_key_path = KEY_PFSENSE
    pfsense_soc_1.ssh.insert_key = false
    pfsense_soc_1.ssh.keys_only = true
    pfsense_soc_1.ssh.shell = "/bin/sh"

    pfsense_soc_1.vm.network "private_network", virtualbox__intnet: "core-transit-net", auto_config: false
    pfsense_soc_1.vm.network "private_network", virtualbox__intnet: "soc-net", auto_config: false

    pfsense_soc_1.vm.provider "virtualbox" do |vb|
      vb.name = "pfsense-soc-1"
      vb.cpus = 2
      vb.memory = 2048
      vb.gui = false
    end
  end


  config.vm.define "pfsense-data-1" do |pfsense_data_1|
