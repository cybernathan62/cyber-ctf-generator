<?xml version="1.0"?>
<pfsense>
  <system>
    <hostname>pfsense-internal-1</hostname>
    <domain>lab.local</domain>
  </system>
  <interfaces>

    <opt3>
      <enable>1</enable>
      <if>transit</if>
      <ipaddr>10.2.104.11</ipaddr>
      <subnet>24</subnet>
      <descr>transit</descr>
    </opt3>

    <opt2>
      <enable>1</enable>
      <if>data</if>
      <ipaddr>10.2.165.11</ipaddr>
      <subnet>24</subnet>
      <descr>data</descr>
    </opt2>

    <opt1>
      <enable>1</enable>
      <if>soc</if>
      <ipaddr>10.2.161.11</ipaddr>
      <subnet>24</subnet>
      <descr>soc</descr>
    </opt1>
  </interfaces>
  <aliases>

    <alias>
      <name>ALIAS_WAZUH_SERVERS</name>
      <type>host</type>
      <address>10.2.161.191 10.2.161.141 10.2.161.195</address>
      <descr>All Wazuh server IPs</descr>
    </alias>

    <alias>
      <name>ALIAS_DB_SERVERS</name>
      <type>host</type>
      <address>10.2.165.166 10.2.165.131 10.2.165.83</address>
      <descr>All DB server IPs</descr>
    </alias>

    <alias>
      <name>ALIAS_BASTION_HOSTS</name>
      <type>host</type>
      <address>10.2.158.64</address>
      <descr>All bastion host IPs</descr>
    </alias>

    <alias>
      <name>ALIAS_MGMT_NET</name>
      <type>network</type>
      <address>10.2.158.0/24</address>
      <descr>Management network CIDRs</descr>
    </alias>

    <alias>
      <name>ALIAS_SOC_NET</name>
      <type>network</type>
      <address>10.2.161.0/24</address>
      <descr>SOC network CIDRs</descr>
    </alias>

    <alias>
      <name>ALIAS_DATA_NET</name>
      <type>network</type>
      <address>10.2.165.0/24</address>
      <descr>Data network CIDRs</descr>
    </alias>

    <alias>
      <name>ALIAS_TRANSIT_NET</name>
      <type>network</type>
      <address>10.2.104.0/24</address>
      <descr>Transit network CIDRs</descr>
    </alias>
  </aliases>
  <filter>

    <rule>
      <type>pass</type>
      <interface>opt1</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>tcp</protocol>
      <descr>Allow Wazuh traffic</descr>
      <source>
        <address>soc-net</address>
      </source>
      <destination>
        <address>wazuh_server</address>
        <port>1514,1515,55000,443</port>
      </destination>
    </rule>

    <rule>
      <type>pass</type>
      <interface>opt1</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>icmp</protocol>
      <descr>Allow ICMP from SOC</descr>
      <source>
        <address>soc-net</address>
      </source>
      <destination>
        <any/>
        
      </destination>
    </rule>

    <rule>
      <type>pass</type>
      <interface>opt2</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>tcp</protocol>
      <descr>Allow DB + SSH from management</descr>
      <source>
        <address>management-net</address>
      </source>
      <destination>
        <address>db_server</address>
        <port>3306,22</port>
      </destination>
    </rule>
  </filter>
</pfsense>
