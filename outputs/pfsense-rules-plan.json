{
  "pf_rules": [
    {
      "firewall": "pfsense-edge-1",
      "interface": "management",
      "action": "pass",
      "protocol": "icmp",
      "source": "management-net",
      "destination": "any",
      "description": "Allow ICMP from management"
    },
    {
      "firewall": "pfsense-edge-1",
      "interface": "management",
      "action": "pass",
      "protocol": "tcp",
      "source": "management-net",
      "destination": "any",
      "destination_ports": [
        22,
        443
      ],
      "description": "Allow SSH + HTTPS from management"
    },
    {
      "firewall": "pfsense-edge-1",
      "interface": "management",
      "action": "pass",
      "protocol": "tcp_udp",
      "source": "management-net",
      "destination": "any",
      "destination_ports": [
        53
      ],
      "description": "Allow DNS from management"
    },
    {
      "firewall": "pfsense-edge-1",
      "interface": "soc",
      "action": "pass",
      "protocol": "tcp",
      "source": "soc-net",
      "destination": "wazuh_server",
      "destination_ports": [
        1514,
        1515,
        55000,
        443
      ],
      "description": "Allow Wazuh traffic"
    },
    {
      "firewall": "pfsense-edge-1",
      "interface": "soc",
      "action": "pass",
      "protocol": "icmp",
      "source": "soc-net",
      "destination": "any",
      "description": "Allow ICMP from SOC"
    },
    {
      "firewall": "pfsense-edge-1",
      "interface": "data",
      "action": "pass",
      "protocol": "tcp",
      "source": "management-net",
      "destination": "db_server",
      "destination_ports": [
        3306,
        22
      ],
      "description": "Allow DB + SSH from management"
    },
    {
      "firewall": "pfsense-edge-1",
      "interface": "wan",
      "action": "pass",
